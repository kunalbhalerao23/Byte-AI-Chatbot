# Copy this file to `.env` and fill in your real key.
# `.env` is git-ignored. Never commit a real key.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-3.8-flash
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=2

# Context window management
# Number of most-recent messages always sent verbatim
MAX_RECENT_MESSAGES=4
# Older messages are only summarised once they exceed MAX_RECENT_MESSAGES by this many
SUMMARIZE_BATCH=2
